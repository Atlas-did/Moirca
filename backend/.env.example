# ============================================================
# WebBridge backend 环境配置
# 复制为 backend/.env 并填入实际值。安全默认值即下方所示,勿随意放宽。
# ============================================================

# ---- LLM(必填,OpenAI 兼容 API;不配则走规则降级) ----
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ---- 本地模型(可选,秒答降本/路由 embedding 增强) ----
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=deepseek-v4
# 路由 embedding 增强开关(默认 off,纯关键词主路径)
WEBBRIDGE_ROUTER_EMBEDDING=off

# ---- 服务配置(安全默认:只绑回环、DEBUG 关闭) ----
HOST=127.0.0.1
PORT=8000
DEBUG=false
# CORS 白名单(逗号分隔;仅前端独立部署时需要)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 / 上传 ----
DATABASE_PATH=./data/moirca.db
# 上传大小上限(字节,默认 10MB)
MAX_UPLOAD_BYTES=10485760

# ---- 可选 API 鉴权(backend/app/api/auth.py) ----
# 留空 = 不鉴权(本地 127.0.0.1 开发零配置);
# 设置后 /api/evidence/*、/api/report、/api/deep-research 要求请求头
# X-WebBridge-Token:<此值>。daemon 侧对应 WEBBRIDGE_BACKEND_TOKEN。
WEBBRIDGE_API_TOKEN=

# ---- 证据层(AGENT_02;CONTRACT §c/§f/§h) ----
# artifacts 根目录(与 daemon 的 WEBBRIDGE_ARTIFACTS_DIR 指向同一处)
WEBBRIDGE_ARTIFACTS_DIR=../daemon/artifacts
# evidence.quote 字符上限(CONTRACT 硬性 2000)
EVIDENCE_QUOTE_MAX_CHARS=2000

# ---- 深研管线(AGENT_05;CONTRACT §e.3) ----
DEEP_RESEARCH_DEFAULT_MINUTES=10
DEEP_RESEARCH_DEFAULT_MAX_EVIDENCE=50
DEEP_RESEARCH_QUERY_MAX_CHARS=2000
DEEP_RESEARCH_SAVE_RETRIES=2
