# ============================================
# Moirca 环境配置
# 复制此文件为 .env 并填入实际值
# ============================================

# LLM配置（必填，支持OpenAI兼容API）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# 本地模型（可选，用于简单查询降本）
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=deepseek-v4

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据库路径（默认本地SQLite）
DATABASE_PATH=./data/moirca.db
