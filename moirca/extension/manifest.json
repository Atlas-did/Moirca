{
  "manifest_version": 3,
  "name": "Moirca 志愿填报助手",
  "version": "0.1.0",
  "description": "辅助高考志愿填报：智能表单侦测、一键填充、结构化数据导出。支持广东/浙江/山东/江苏/河南/四川/湖北。",
  "author": "Moirca",
  "homepage_url": "https://github.com/moirca",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "*://*.gov.cn/*",
    "*://*.edu.cn/*",
    "*://*.chsi.com.cn/*",
    "*://pg.eeagd.edu.cn/*",
    "*://wsbm.sdzk.cn/*",
    "*://gk.jseea.cn/*",
    "*://pzwb.haeea.cn/*",
    "*://gkzy.sceea.cn/*",
    "*://zspt.hubzs.com.cn/*",
    "*://www.zjzs.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gov.cn/*",
        "*://*.edu.cn/*",
        "*://*.chsi.com.cn/*"
      ],
      "js": ["utils/province-configs.js", "utils/form-detector.js", "utils/form-filler.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Moirca 填报助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
