# ============================================================
# WebBridge daemon 环境配置
# 复制为 daemon/.env 或以环境变量方式注入。全部可省略(默认即本地安全值)。
# ============================================================

# ---- WS Server(daemon ↔ 扩展) ----
# 只绑 127.0.0.1,不可改对外地址;端口默认 9223
WEBBRIDGE_WS_PORT=9223
# 命令级 WS 等待超时(毫秒,默认 30000)
WEBBRIDGE_CMD_TIMEOUT_MS=30000
# 预共享扩展配对 token(默认启动时随机生成,写入 daemon/.bridge-token,0600)
WEBBRIDGE_TOKEN=

# ---- 证据钩子(daemon → backend 自动落库) ----
# backend 证据落库端点
WEBBRIDGE_EVIDENCE_URL=http://127.0.0.1:8000/api/evidence/save
# 置 1 关闭自动落库(默认开启)
WEBBRIDGE_EVIDENCE_OFF=
# backend 开启 WEBBRIDGE_API_TOKEN 鉴权时,填同一个值(随 X-WebBridge-Token 头发送)
WEBBRIDGE_BACKEND_TOKEN=

# ---- 文件旁路(artifacts,CONTRACT §f) ----
# artifacts 根目录(默认 daemon/artifacts;backend 的 WEBBRIDGE_ARTIFACTS_DIR 应指向同一处)
WEBBRIDGE_ARTIFACTS_DIR=
# 清理 TTL(小时,默认 168 = 7 天;仅显式触发清理时生效,不自动删除)
WEBBRIDGE_ARTIFACT_TTL_HOURS=168

# ---- extract 增强(默认本地 readability,无需配置) ----
# 外部 reader API(Jina/Firecrawl 等);留空 = 关闭,只用本地转换
WEBBRIDGE_READER_API_URL=

# ---- MCP 可选工具 ----
# 置 on 注册 browser_route(调 backend POST /api/route);默认关闭
WEBBRIDGE_MCP_ROUTE_TOOL=
