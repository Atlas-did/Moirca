{
  "name": "@webbridge/daemon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "WebBridge 本地桥:MCP Server(stdio)↔ WS Server(127.0.0.1:9223)↔ Chrome 扩展",
  "main": "dist/index.js",
  "bin": {
    "webbridge": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start-mcp": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx tests/smoke.e2e.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jsdom": "^27.0.0",
    "turndown": "^7.2.1",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "@types/ws": "^8.5.0",
    "@webbridge/shared-types": "file:../shared-types",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
